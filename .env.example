# --- LiveKit (https://cloud.livekit.io -> your project -> Settings -> Keys) ---
LIVEKIT_URL=wss://your-project-id.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key

# --- Optional settings (defaults shown) ---
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
STT_LANGUAGE=en
CLINIC_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# --- Voice output (TTS) ---
# groq    = Groq Orpheus (needs terms accepted in the Groq console)
# livekit = LiveKit Cloud built-in voice (uses your LiveKit project, no extra key)
TTS_PROVIDER=groq
TTS_INFERENCE_MODEL=cartesia/sonic-2
TTS_INFERENCE_VOICE=794f9389-aac1-45b6-b726-9d9369183238
